# ---------------------------------------------------------------------------
# SERENOU — variáveis de ambiente
#
# Copie para .env.local (na sua máquina) e cadastre os mesmos valores na
# Vercel, em Settings > Environment Variables.
#
# .env.local NÃO vai para o Git. Está no .gitignore.
#
# Não há nenhum segredo aqui. O projeto não usa token do Sanity: escrever
# exige login no painel, e ler é aberto porque o dataset é público — dataset
# privado é recurso do plano Growth.
# ---------------------------------------------------------------------------

# Id do projeto no Sanity. Aparece em sanity.io/manage, na URL do projeto.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Conjunto de dados. Use "production", e deixe-o PÚBLICO.
NEXT_PUBLIC_SANITY_DATASET=production

# Domínio definitivo do site, quando existir. Exemplo:
# NEXT_PUBLIC_SITE_URL=https://serenoubeach.com.br
# Sem ele, em deploy a Vercel informa a própria URL. Não invente um domínio:
# um endereço errado aqui gera links quebrados no compartilhamento.
NEXT_PUBLIC_SITE_URL=
